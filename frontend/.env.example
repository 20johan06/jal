# Frontend Environment Configuration
# HACK THE SYSTEM — SRKR Engineering College

# Backend API base URL
# During local development with Vite dev proxy, leave blank or set to '/api'
# For standalone frontend build pointing directly to backend on LAN:
# VITE_API_URL=http://localhost:5000/api
# Or for campus lab LAN server:
# VITE_API_URL=http://<SERVER_IP>:5000/api
VITE_API_URL=/api
