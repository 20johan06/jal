# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / MariaDB via XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hack_the_system

# JWT Authentication Secret (REQUIRED: minimum 16 characters)
# Generate a secure random string for production
JWT_SECRET=replace_with_a_secure_random_key_min_16_chars
JWT_EXPIRES_IN=24h

# Initial Administrator Credentials (For initial npm run db:seed setup)
# Password must be at least 8 characters long
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_admin_password_min_8_chars
